# Secrets referenced by config/deploy.yml. This file is committed; do NOT put
# raw values here. Each variable below is sourced from your local environment
# (set before running `bin/kamal …`) or a password manager.
#
# Suggested workflow: keep a `.env.kamal` (gitignored) with the values, and
# `set -a; source .env.kamal; set +a` before invoking Kamal.

# --- Required ---

# Rails encrypted-credentials key. We use env-scoped credentials, so this is
# the *production* key file.
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# GitHub Container Registry password (a PAT with `write:packages` scope).
# Create at: https://github.com/settings/tokens
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Postgres accessory password. Used as the app's DB password too.
# Generate once: `openssl rand -base64 32` — then keep it.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
BUGSY_DATABASE_PASSWORD=$POSTGRES_PASSWORD

# smsapi.bg + Google Maps keys live in config/credentials/production.yml.enc;
# the production master key (RAILS_MASTER_KEY above) decrypts them inside the
# running container, so no env vars are needed for these.
