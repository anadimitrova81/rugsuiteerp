<div class="welcome-overlay"
     data-controller="welcome"
     data-welcome-target="overlay"
     data-welcome-storage-key-value="rugsuite:welcome:dismissed:<%= current_factory.slug %>">
  <div class="welcome-modal" role="dialog" aria-modal="true" aria-labelledby="welcome-modal-title">
    <button type="button" class="welcome-close" data-action="click->welcome#close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <h2 id="welcome-modal-title" class="welcome-title">
      <%= t("home.welcome.title", name: current_factory.name) %>
    </h2>

    <%# Three steps. Stimulus hides all but the active one via [hidden]. %>
    <% (1..3).each_with_index do |n, idx| %>
      <div class="welcome-step" data-welcome-target="step" <%= "hidden" if idx > 0 %>>
        <span class="welcome-eyebrow"><%= t("home.welcome.step_#{n}.eyebrow") %></span>
        <h3 class="welcome-step-heading"><%= t("home.welcome.step_#{n}.heading") %></h3>
        <p class="welcome-step-body"><%= t("home.welcome.step_#{n}.body", slug: current_factory.slug).html_safe %></p>

        <% if n == 2 %>
          <button type="button"
                  class="btn btn-secondary welcome-show-me"
                  data-action="click->welcome#revealLogin">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
            <%= t("home.welcome.step_2.show_me") %>
          </button>
        <% end %>
      </div>
    <% end %>

    <div class="welcome-indicators" aria-hidden="true">
      <% 3.times do |idx| %>
        <span class="welcome-indicator" data-welcome-target="indicator" data-active="<%= idx == 0 %>"></span>
      <% end %>
    </div>

    <div class="welcome-actions">
      <button type="button" class="btn btn-secondary" data-welcome-target="back" data-action="click->welcome#back" hidden>
        <%= t("home.welcome.back") %>
      </button>

      <%# Steps 1–2: Next. Last step: Close + Login. The controller toggles
          visibility via the `next` / `close` / `login` targets in render(). %>
      <button type="button"
              class="btn btn-primary"
              data-welcome-target="next"
              data-action="click->welcome#next">
        <%= t("home.welcome.next") %>
      </button>
      <button type="button"
              class="btn btn-secondary"
              data-welcome-target="close"
              data-action="click->welcome#close"
              hidden>
        <%= t("home.welcome.close") %>
      </button>
      <%= link_to t("home.welcome.login"),
                  login_path,
                  class: "btn btn-primary",
                  data: { welcome_target: "login", action: "click->welcome#markDismissedAction" },
                  hidden: true %>
    </div>
  </div>
</div>
