<div class="cookie-consent"
     data-controller="cookie-consent"
     data-cookie-consent-storage-key-value="nexus_cookie_consent_v1"
     hidden>
  <div class="cookie-consent-inner">
    <div class="cookie-consent-text">
      <h2 class="cookie-consent-title"><%= t("cookie_consent.title") %></h2>
      <p>
        <%= t("cookie_consent.body_html", link: link_to(t("cookie_consent.privacy_link"), privacy_path, class: "cookie-consent-link")) %>
      </p>
    </div>
    <div class="cookie-consent-actions">
      <button type="button"
              class="btn btn-secondary cookie-consent-btn"
              data-action="cookie-consent#reject">
        <%= t("cookie_consent.reject") %>
      </button>
      <button type="button"
              class="btn btn-primary cookie-consent-btn"
              data-action="cookie-consent#accept">
        <%= t("cookie_consent.accept") %>
      </button>
    </div>
  </div>
</div>
