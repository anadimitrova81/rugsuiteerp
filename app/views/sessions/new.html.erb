<% content_for(:title) { "#{t("sessions.page_title")} · Example Cleaning" } %>

<div class="container">
  <div class="login-card">
    <div class="login-header">
      <div class="login-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h1 class="login-title"><%= t("sessions.title") %></h1>
      <p class="login-subtitle"><%= t("sessions.subtitle") %></p>
    </div>

    <%= form_with url: login_path, method: :post, class: "login-form" do |form| %>
      <label class="login-field">
        <span class="login-field-label"><%= t("sessions.email_label") %></span>
        <span class="login-field-input">
          <svg class="login-field-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          <%= form.email_field :email, placeholder: "ime@example.com", autofocus: true, autocomplete: "email", required: true, skip_group: true %>
        </span>
      </label>

      <label class="login-field">
        <span class="login-field-label"><%= t("sessions.password_label") %></span>
        <span class="login-field-input">
          <svg class="login-field-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <%= form.password_field :password, placeholder: "••••••••", autocomplete: "current-password", required: true, skip_group: true %>
        </span>
      </label>

      <%= form.submit t("sessions.submit"), class: "btn btn-primary btn-full" %>
    <% end %>
  </div>
</div>
