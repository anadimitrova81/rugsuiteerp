<% content_for(:title) { t("home.title") } %>

<%= render "shared/welcome_modal" if @show_welcome %>

<section class="home-hero">
  <div class="home-hero-inner">
    <div class="home-hero-text">
      <span class="home-eyebrow"><%= t("home.hero.eyebrow") %></span>
      <h1 class="home-hero-title"><%= t("home.hero.title") %></h1>
      <p class="home-hero-subtitle"><%= t("home.hero.subtitle") %></p>
      <div class="home-hero-actions">
        <%= link_to t("home.hero.cta_book"), new_request_path, class: "btn btn-primary btn-lg" %>
        <%= link_to t("home.hero.cta_status"), status_path, class: "btn btn-secondary btn-lg" %>
      </div>
      <ul class="home-hero-bullets">
        <% t("home.hero.bullets", pickup_window: current_factory.pickup_window).each do |bullet| %>
          <li><%= bullet %></li>
        <% end %>
      </ul>
    </div>
    <div class="home-hero-art">
      <div class="home-hero-blob" aria-hidden="true"></div>
      <div class="home-hero-dots" aria-hidden="true"></div>
      <div class="home-hero-ring" aria-hidden="true"></div>

      <div class="home-hero-photo-frame">
        <%= image_tag "washing-mashine.jpg", alt: t("home.hero.title"), class: "home-hero-photo" %>
      </div>

      <div class="home-hero-chip home-hero-chip-top" aria-hidden="true">
        <span class="home-hero-chip-num">6</span>
        <span class="home-hero-chip-label"><%= t("home.hero.chip_steps") %></span>
      </div>

      <div class="home-hero-chip home-hero-chip-bottom" aria-hidden="true">
        <span class="home-hero-chip-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
        </span>
        <div class="home-hero-chip-text">
          <span class="home-hero-chip-title"><%= t("home.hero.chip_eco_title") %></span>
          <span class="home-hero-chip-sub"><%= t("home.hero.chip_eco_sub") %></span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-section-inner">
    <div class="home-section-head">
      <span class="home-eyebrow"><%= t("home.why_us.eyebrow") %></span>
      <h2><%= t("home.why_us.heading") %></h2>
      <p class="home-section-lede"><%= t("home.why_us.lede") %></p>
    </div>
    <div class="home-features">
      <article class="home-feature">
        <span class="home-feature-num" aria-hidden="true">01</span>
        <div class="home-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
        </div>
        <h3><%= t("home.why_us.feature_1.title") %></h3>
        <p><%= t("home.why_us.feature_1.body", pickup_window: current_factory.pickup_window) %></p>
        <span class="home-feature-tag"><%= t("home.why_us.feature_1.tag", pickup_window: current_factory.pickup_window) %></span>
      </article>
      <article class="home-feature">
        <span class="home-feature-num" aria-hidden="true">02</span>
        <div class="home-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
        </div>
        <h3><%= t("home.why_us.feature_2.title") %></h3>
        <p><%= t("home.why_us.feature_2.body") %></p>
        <span class="home-feature-tag"><%= t("home.why_us.feature_2.tag") %></span>
      </article>
      <article class="home-feature">
        <span class="home-feature-num" aria-hidden="true">03</span>
        <div class="home-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
        </div>
        <h3><%= t("home.why_us.feature_3.title") %></h3>
        <p><%= t("home.why_us.feature_3.body") %></p>
        <span class="home-feature-tag"><%= t("home.why_us.feature_3.tag") %></span>
      </article>
    </div>
  </div>
</section>

<section class="home-section home-section-alt">
  <div class="home-section-inner">
    <div class="home-section-head">
      <span class="home-eyebrow"><%= t("home.how_it_works.eyebrow") %></span>
      <h2><%= t("home.how_it_works.heading") %></h2>
    </div>

    <div class="process-slider">
      <input type="radio" name="process-step" id="step-radio-1" class="process-radio" checked>
      <input type="radio" name="process-step" id="step-radio-2" class="process-radio">
      <input type="radio" name="process-step" id="step-radio-3" class="process-radio">
      <input type="radio" name="process-step" id="step-radio-4" class="process-radio">
      <input type="radio" name="process-step" id="step-radio-5" class="process-radio">
      <input type="radio" name="process-step" id="step-radio-6" class="process-radio">

      <div class="process-slides-viewport">
        <div class="process-slides">
          <% (1..6).each do |n| %>
            <article class="process-slide" id="step-<%= n %>">
              <div class="process-slide-image">
                <%= image_tag "step#{n}#{n == 3 || n == 4 || n == 5 ? '.png' : '.jpg'}", alt: t("home.how_it_works.step_#{n}.title") %>
              </div>
              <div class="process-slide-body">
                <span class="process-slide-bignum" aria-hidden="true"><%= "%02d" % n %></span>
                <span class="process-slide-num"><%= t("home.how_it_works.step_label", n: "%02d" % n) %></span>
                <h3><%= t("home.how_it_works.step_#{n}.title") %></h3>
                <p><%= t("home.how_it_works.step_#{n}.body", pickup_window: current_factory.pickup_window) %></p>
              </div>
            </article>
          <% end %>
        </div>
      </div>

      <nav class="process-dots" aria-label="<%= t("home.how_it_works.heading") %>">
        <% (1..6).each do |n| %>
          <label for="step-radio-<%= n %>" class="process-dot" aria-label="<%= t("home.how_it_works.step_label", n: n) %>"><%= n %></label>
        <% end %>
      </nav>
    </div>
  </div>
</section>

<section id="prices" class="home-section">
  <div class="home-section-inner">
    <div class="home-section-head">
      <span class="home-eyebrow"><%= t("home.pricing.eyebrow") %></span>
      <h2><%= t("home.pricing.heading") %></h2>
    </div>
    <div class="home-pricing">
      <div class="home-pricing-card">
        <div class="home-pricing-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
        </div>
        <h3><%= t("home.pricing.duvets_title") %></h3>
        <div class="home-pricing-amount"><%= t("home.pricing.duvets_price_html", price: number_with_precision(current_factory.price_per_kg, precision: 2, strip_insignificant_zeros: true), currency: current_factory.currency).html_safe %></div>
        <p class="home-pricing-note"><%= t("home.pricing.duvets_note", threshold: current_factory.bulk_weight_threshold.to_i, bulk_price: number_with_precision(current_factory.price_per_kg_bulk, precision: 2, strip_insignificant_zeros: true), currency: current_factory.currency) %></p>
      </div>
      <div class="home-pricing-card home-pricing-card-featured">
        <span class="home-pricing-badge"><%= t("home.pricing.carpets_badge") %></span>
        <div class="home-pricing-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h10"/><path d="M7 14h10"/></svg>
        </div>
        <h3><%= t("home.pricing.carpets_title") %></h3>
        <div class="home-pricing-amount"><%= t("home.pricing.duvets_price_html", price: number_with_precision(current_factory.price_per_kg, precision: 2, strip_insignificant_zeros: true), currency: current_factory.currency).html_safe %></div>
        <p class="home-pricing-note"><%= t("home.pricing.duvets_note", threshold: current_factory.bulk_weight_threshold.to_i, bulk_price: number_with_precision(current_factory.price_per_kg_bulk, precision: 2, strip_insignificant_zeros: true), currency: current_factory.currency) %></p>
      </div>
      <div class="home-pricing-card">
        <div class="home-pricing-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" x2="2" y1="8" y2="22"/><line x1="17.5" x2="9" y1="15" y2="15"/></svg>
        </div>
        <h3><%= t("home.pricing.quilts_title") %></h3>
        <div class="home-pricing-amount"><%= t("home.pricing.quilts_price_html", price: number_with_precision(current_factory.price_per_item, precision: 2, strip_insignificant_zeros: true), currency: current_factory.currency).html_safe %></div>
      </div>
    </div>
  </div>
</section>

<section class="home-cta">
  <div class="home-cta-inner">
    <h2><%= t("home.cta.heading") %></h2>
    <p><%= t("home.cta.subtitle") %></p>
    <%= link_to t("home.cta.button"), new_request_path, class: "btn btn-primary btn-lg" %>
  </div>
</section>

<footer class="home-footer">
  <div class="home-footer-inner">
    <div>
      <strong class="home-footer-brand"><%= current_factory.name %></strong>
      <p><%= t("home.footer.brand_blurb") %></p>
    </div>
    <div>
      <h4><%= t("home.footer.service_heading") %></h4>
      <ul>
        <li><%= link_to t("nav.book"),         new_request_path %></li>
        <li><%= link_to t("nav.check_order"),  status_path %></li>
        <li><%= link_to t("nav.faq"),          faq_path %></li>
        <li><%= link_to t("nav.contact"),      contacts_path %></li>
      </ul>
    </div>
    <div>
      <h4><%= t("home.footer.contact_heading") %></h4>
      <ul>
        <% if current_factory.phone.present? %>
          <li><a href="tel:<%= current_factory.phone.gsub(/\s+/, "") %>"><%= current_factory.phone %></a></li>
        <% end %>
        <% if current_factory.email.present? %>
          <li><a href="mailto:<%= current_factory.email %>"><%= current_factory.email %></a></li>
        <% end %>
        <% if current_factory.business_hours.present? %>
          <li><%= t("home.footer.intake_label") %>: <%= current_factory.business_hours %></li>
        <% end %>
        <% if current_factory.pickup_window.present? %>
          <li><%= t("home.footer.pickup_label") %>: <%= current_factory.pickup_window %></li>
        <% end %>
      </ul>
    </div>
  </div>
  <div class="home-footer-bottom">
    <span><%= t("home.footer.copyright", year: Date.current.year, name: current_factory.legal_name.presence || current_factory.name) %></span>
    <nav class="home-footer-legal" aria-label="<%= t("nav.faq") %>">
      <%= link_to t("home.footer.legal.terms"),   terms_path %>
      <%= link_to t("home.footer.legal.privacy"), privacy_path %>
      <%= link_to t("nav.staff_login"),           login_path, class: "home-footer-staff" %>
    </nav>
  </div>
</footer>
