<% content_for(:title) { "#{t('contacts.hero.eyebrow')} · Example Cleaning" } %>

<section class="contacts-hero">
  <div class="contacts-hero-inner">
    <span class="home-eyebrow"><%= t("contacts.hero.eyebrow") %></span>
    <h1><%= t("contacts.hero.title") %></h1>
    <p><%= t("contacts.hero.lede") %></p>
  </div>
</section>

<section class="home-section">
  <div class="home-section-inner">
    <div class="contacts-grid">
      <a class="contacts-card" href="tel:+359899771972">
        <div class="contacts-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <span class="contacts-card-label"><%= t("contacts.cards.phone.label") %></span>
        <span class="contacts-card-value">+359 899 771 972</span>
        <span class="contacts-card-note"><%= t("contacts.cards.phone.note") %></span>
      </a>

      <a class="contacts-card" href="viber://chat?number=%2B359899771972">
        <div class="contacts-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <span class="contacts-card-label"><%= t("contacts.cards.sms.label") %></span>
        <span class="contacts-card-value">+359 899 771 972</span>
        <span class="contacts-card-note"><%= t("contacts.cards.sms.note") %></span>
      </a>

      <a class="contacts-card" href="mailto:office@example.com">
        <div class="contacts-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        </div>
        <span class="contacts-card-label"><%= t("contacts.cards.email.label") %></span>
        <span class="contacts-card-value">office@example.com</span>
        <span class="contacts-card-note"><%= t("contacts.cards.email.note") %></span>
      </a>

      <div class="contacts-card contacts-card-static">
        <div class="contacts-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <span class="contacts-card-label"><%= t("contacts.cards.pickup.label") %></span>
        <span class="contacts-card-value">18:00 – 20:30</span>
        <span class="contacts-card-note"><%= t("contacts.cards.pickup.note") %></span>
      </div>
    </div>
  </div>
</section>

<section class="home-section home-section-alt">
  <div class="home-section-inner">
    <div class="home-section-head">
      <span class="home-eyebrow"><%= t("contacts.coverage.eyebrow") %></span>
      <h2><%= t("contacts.coverage.heading") %></h2>
      <p class="home-section-lede"><%= t("contacts.coverage.lede") %></p>
    </div>

    <ul class="contacts-cities">
      <% current_factory.service_cities.each do |city| %>
        <li class="contacts-city">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span><%= city %></span>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<section class="home-cta">
  <div class="home-cta-inner">
    <h2><%= t("contacts.cta.heading") %></h2>
    <p><%= t("contacts.cta.lede") %></p>
    <%= link_to t("nav.book"), new_request_path, class: "btn btn-primary btn-lg" %>
  </div>
</section>
