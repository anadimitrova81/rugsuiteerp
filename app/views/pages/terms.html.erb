<% content_for(:title) { t("terms.meta_title") } %>

<section class="legal-hero">
  <div class="legal-hero-inner">
    <span class="home-eyebrow"><%= t("terms.eyebrow") %></span>
    <h1><%= t("terms.title") %></h1>
    <p><%= t("terms.subtitle") %> <%= t("terms.updated", date: Date.current.strftime("%-d %B %Y")) %></p>
  </div>
</section>

<section class="home-section">
  <div class="home-section-inner legal-layout">
    <aside class="legal-toc">
      <h2><%= t("terms.toc_heading") %></h2>
      <ol>
        <li><a href="#scope"><%= t("terms.toc.scope") %></a></li>
        <li><a href="#services"><%= t("terms.toc.services") %></a></li>
        <li><a href="#orders"><%= t("terms.toc.orders") %></a></li>
        <li><a href="#pricing"><%= t("terms.toc.pricing") %></a></li>
        <li><a href="#pickup"><%= t("terms.toc.pickup") %></a></li>
        <li><a href="#timing"><%= t("terms.toc.timing") %></a></li>
        <li><a href="#liability"><%= t("terms.toc.liability") %></a></li>
        <li><a href="#cancellation"><%= t("terms.toc.cancellation") %></a></li>
        <li><a href="#complaints"><%= t("terms.toc.complaints") %></a></li>
        <li><a href="#privacy"><%= t("terms.toc.privacy") %></a></li>
        <li><a href="#changes"><%= t("terms.toc.changes") %></a></li>
        <li><a href="#disputes"><%= t("terms.toc.disputes") %></a></li>
      </ol>
    </aside>

    <article class="legal-content">
      <section id="scope">
        <h2><%= t("terms.sections.scope.heading") %></h2>
        <%= t("terms.sections.scope.body_html") %>
      </section>

      <section id="services">
        <h2><%= t("terms.sections.services.heading") %></h2>
        <%= t("terms.sections.services.body_html") %>
      </section>

      <section id="orders">
        <h2><%= t("terms.sections.orders.heading") %></h2>
        <%= t("terms.sections.orders.body_html") %>
      </section>

      <section id="pricing">
        <h2><%= t("terms.sections.pricing.heading") %></h2>
        <%= t("terms.sections.pricing.body_html") %>
      </section>

      <section id="pickup">
        <h2><%= t("terms.sections.pickup.heading") %></h2>
        <%= t("terms.sections.pickup.body_html") %>
      </section>

      <section id="timing">
        <h2><%= t("terms.sections.timing.heading") %></h2>
        <%= t("terms.sections.timing.body_html") %>
      </section>

      <section id="liability">
        <h2><%= t("terms.sections.liability.heading") %></h2>
        <%= t("terms.sections.liability.body_html") %>
      </section>

      <section id="cancellation">
        <h2><%= t("terms.sections.cancellation.heading") %></h2>
        <%= t("terms.sections.cancellation.body_html") %>
      </section>

      <section id="complaints">
        <h2><%= t("terms.sections.complaints.heading") %></h2>
        <%= t("terms.sections.complaints.body_html") %>
      </section>

      <section id="privacy">
        <h2><%= t("terms.sections.privacy.heading") %></h2>
        <p><%= t("terms.sections.privacy.body_before") %> <%= link_to t("terms.sections.privacy.link_text"), privacy_path %><%= t("terms.sections.privacy.body_after") %></p>
      </section>

      <section id="changes">
        <h2><%= t("terms.sections.changes.heading") %></h2>
        <%= t("terms.sections.changes.body_html") %>
      </section>

      <section id="disputes">
        <h2><%= t("terms.sections.disputes.heading") %></h2>
        <%= t("terms.sections.disputes.body_html") %>
      </section>
    </article>
  </div>
</section>
