      <div class="faq-answer">
        <p><%= t("faq.items.how_to_order.intro") %></p>
        <ul>
          <li><%= t("faq.items.how_to_order.online_html", link: link_to(t("faq.items.how_to_order.form_link"), new_request_path)) %></li>
          <li><%= t("faq.items.how_to_order.by_phone_html") %></li>
          <li><%= t("faq.items.how_to_order.by_sms_html") %></li>
