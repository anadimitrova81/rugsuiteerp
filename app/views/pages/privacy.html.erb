<% content_for(:title) { t("privacy.meta_title") } %>

<section class="legal-hero">
  <div class="legal-hero-inner">
    <span class="home-eyebrow"><%= t("privacy.eyebrow") %></span>
    <h1><%= t("privacy.title") %></h1>
    <p><%= t("privacy.subtitle") %> </p>
    <p><%= t("privacy.updated", date: Date.current.strftime("%-d %B %Y")) %></p>
  </div>
</section>

<section class="home-section">
  <div class="home-section-inner legal-layout">
    <aside class="legal-toc">
      <h2><%= t("privacy.toc_heading") %></h2>
      <ol>
        <li><a href="#controller"><%= t("privacy.toc.controller") %></a></li>
        <li><a href="#data"><%= t("privacy.toc.data") %></a></li>
        <li><a href="#purposes"><%= t("privacy.toc.purposes") %></a></li>
        <li><a href="#legal-basis"><%= t("privacy.toc.legal_basis") %></a></li>
        <li><a href="#sharing"><%= t("privacy.toc.sharing") %></a></li>
        <li><a href="#retention"><%= t("privacy.toc.retention") %></a></li>
        <li><a href="#security"><%= t("privacy.toc.security") %></a></li>
        <li><a href="#rights"><%= t("privacy.toc.rights") %></a></li>
        <li><a href="#cookies"><%= t("privacy.toc.cookies") %></a></li>
        <li><a href="#contact"><%= t("privacy.toc.contact") %></a></li>
        <li><a href="#changes"><%= t("privacy.toc.changes") %></a></li>
      </ol>
    </aside>

    <article class="legal-content">
      <section id="controller">
        <h2><%= t("privacy.sections.controller.heading") %></h2>
        <%= t("privacy.sections.controller.body_html") %>
      </section>

      <section id="data">
        <h2><%= t("privacy.sections.data.heading") %></h2>
        <%= t("privacy.sections.data.body_html") %>
      </section>

      <section id="purposes">
        <h2><%= t("privacy.sections.purposes.heading") %></h2>
        <%= t("privacy.sections.purposes.body_html") %>
      </section>

      <section id="legal-basis">
        <h2><%= t("privacy.sections.legal_basis.heading") %></h2>
        <%= t("privacy.sections.legal_basis.body_html") %>
      </section>

      <section id="sharing">
        <h2><%= t("privacy.sections.sharing.heading") %></h2>
        <%= t("privacy.sections.sharing.body_html") %>
      </section>

      <section id="retention">
        <h2><%= t("privacy.sections.retention.heading") %></h2>
        <%= t("privacy.sections.retention.body_html") %>
      </section>

      <section id="security">
        <h2><%= t("privacy.sections.security.heading") %></h2>
        <%= t("privacy.sections.security.body_html") %>
      </section>

      <section id="rights">
        <h2><%= t("privacy.sections.rights.heading") %></h2>
        <%= t("privacy.sections.rights.body_html") %>
      </section>

      <section id="cookies">
        <h2><%= t("privacy.sections.cookies.heading") %></h2>
        <%= t("privacy.sections.cookies.body_html") %>
      </section>

      <section id="contact">
        <h2><%= t("privacy.sections.contact.heading") %></h2>
        <%= t("privacy.sections.contact.body_html") %>
      </section>

      <section id="changes">
        <h2><%= t("privacy.sections.changes.heading") %></h2>
        <%= t("privacy.sections.changes.body_html") %>
      </section>
    </article>
  </div>
</section>
