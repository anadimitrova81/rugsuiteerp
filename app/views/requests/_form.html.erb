<% form_data = { turbo: false } %>
<% if recaptcha_site_key.present? %>
  <% form_data.merge!(controller: "recaptcha", recaptcha_site_key_value: recaptcha_site_key, recaptcha_action_value: "request_create") %>
<% end %>
<%= form_with(model: request, scope: :request, class: "request-form", data: form_data) do |form| %>
  <section class="form-section">
    <h2 class="form-section-title"><%= t("requests.form.section_contact") %></h2>
    <%= form.telephone_field :phone, label: t("requests.form.phone_label"), placeholder: t("requests.form.phone_placeholder") %>
  </section>

  <section class="form-section">
    <h2 class="form-section-title"><%= t("requests.form.section_pickup_address") %></h2>
    <div class="form-row form-row-2-1">
      <%= form.text_field :address, label: t("requests.form.address_label"), placeholder: t("requests.form.address_placeholder") %>
      <%= form.select :city, current_factory.service_cities, { label: t("requests.form.city_label"), include_blank: t("requests.form.city_prompt") } %>
    </div>
  </section>

  <section class="form-section">
    <h2 class="form-section-title"><%= t("requests.form.section_schedule") %></h2>
    <%= form.date_field :pick_up_at, label: t("requests.form.pickup_date_label"), min: Request.earliest_pick_up_date, hint: t("requests.form.pickup_date_hint"), onclick: "this.showPicker()", data: { controller: "pickup-date", action: "change->pickup-date#check", "pickup-date-message": t("admin.request.validations.pick_up_at_weekend") } %>
    <%= form.text_area :pick_up_notes, label: t("requests.form.pickup_notes_label"), rows: 3, placeholder: t("requests.form.pickup_notes_placeholder") %>
  </section>

  <% if recaptcha_site_key.present? %>
    <input type="hidden" name="g-recaptcha-response" data-recaptcha-target="token">
    <p class="recaptcha-notice"><%= t("requests.form.recaptcha_notice_html") %></p>
  <% end %>

  <div class="form-actions">
    <%= form.submit t("requests.form.submit"), class: "btn btn-primary btn-lg" %>
  </div>
<% end %>
