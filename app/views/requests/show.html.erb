<% content_for(:title) { "#{t("requests.show.page_title")} · Nexus Cleaning" } %>

<div class="container">
  <div class="confirmation">
    <div class="confirmation-header">
      <div class="confirmation-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5" />
        </svg>
      </div>
      <h1 class="confirmation-title"><%= t("requests.show.title") %></h1>
      <p class="confirmation-message"><%= t("requests.show.message") %></p>
    </div>

    <div class="confirmation-reference">
      <span class="confirmation-reference-label"><%= t("requests.show.reference_label") %></span>
      <span class="confirmation-reference-id"><%= @request.customer_id %></span>
    </div>

    <% if @request.pick_up_at.present? %>
      <div class="confirmation-pickup">
        <div class="confirmation-pickup-day">
          <span class="confirmation-pickup-weekday"><%= bg_weekday(@request.pick_up_at) %></span>
          <span class="confirmation-pickup-date"><%= bg_long_date(@request.pick_up_at) %></span>
        </div>
        <div class="confirmation-pickup-window">
          <span class="confirmation-pickup-label"><%= t("requests.show.pickup_label") %></span>
          <span class="confirmation-pickup-time">18:00 – 20:30</span>
        </div>
      </div>
    <% end %>

    <dl class="confirmation-details">
      <div>
        <dt><%= t("requests.show.phone_label") %></dt>
        <dd><%= @request.phone %></dd>
      </div>
      <div>
        <dt><%= t("requests.show.address_label") %></dt>
        <dd><%= [@request.address, @request.city].compact_blank.join(", ") %></dd>
      </div>
      <% if @request.pick_up_notes.present? %>
        <div>
          <dt><%= t("requests.show.notes_label") %></dt>
          <dd><%= simple_format(@request.pick_up_notes) %></dd>
        </div>
      <% end %>
    </dl>

    <div class="confirmation-actions">
      <%= link_to t("requests.show.check_status"), status_path(query: @request.customer_id), class: "btn btn-primary" %>
      <%= link_to t("requests.show.new_request"), new_request_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
