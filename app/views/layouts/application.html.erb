<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || current_factory.name %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <% unless indexable_page? %>
      <meta name="robots" content="noindex, follow">
    <% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= current_factory.name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Social sharing + local-business structured data on the tenant's public
        marketing pages, all keyed off the current factory. %>
    <% if params[:controller] == "pages" %>
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="<%= current_factory.name %>">
      <meta property="og:title" content="<%= content_for(:title) || current_factory.name %>">
      <meta property="og:description" content="<%= page_description %>">
      <meta property="og:url" content="<%= canonical_url %>">
      <% if current_factory.logo.attached? %>
        <meta property="og:image" content="<%= url_for(current_factory.logo) %>">
      <% end %>
      <meta name="twitter:card" content="summary">
      <%= render "layouts/structured_data" %>
    <% end %>

    <%= yield :head %>

    <% if recaptcha_site_key.present? %>
      <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptcha_site_key %>" async defer></script>
    <% end %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= render "layouts/js_i18n" %>
    <%= javascript_importmap_tags %>

    <%# Per-tenant brand color override. Each value falls through to the
        default token from application.css when the factory hasn't set one. %>
    <% primary_rgb   = hex_to_rgb_triplet(current_factory.brand_primary_color) %>
    <% secondary_rgb = hex_to_rgb_triplet(current_factory.brand_secondary_color) %>
    <% if current_factory.brand_primary_color.present? || current_factory.brand_secondary_color.present? %>
      <style>
        :root {
          <% if current_factory.brand_primary_color.present? %>
            --color-primary: <%= current_factory.brand_primary_color %>;
            <% if primary_rgb %>--color-primary-rgb: <%= primary_rgb %>;<% end %>
            --color-primary-hover: color-mix(in srgb, <%= current_factory.brand_primary_color %> 75%, black);
          <% end %>
          <% if current_factory.brand_secondary_color.present? %>
            --color-secondary: <%= current_factory.brand_secondary_color %>;
            <% if secondary_rgb %>--color-secondary-rgb: <%= secondary_rgb %>;<% end %>
            --color-secondary-hover: color-mix(in srgb, <%= current_factory.brand_secondary_color %> 85%, black);
          <% end %>
        }
      </style>
    <% end %>
  </head>

  <body>
    <% if impersonating? %>
      <div class="impersonation-banner">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m17 11 2 2 4-4"/></svg>
        <span><%= t("admin.impersonation.banner_html", current: tag.strong(current_admin.email), true: true_admin&.email).html_safe %></span>
        <%= button_to t("admin.impersonation.stop"), admin_stop_impersonating_path, method: :delete, class: "impersonation-banner-btn" %>
      </div>
    <% elsif platform_impersonating? %>
      <div class="impersonation-banner impersonation-banner-platform">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span><%= t("admin.impersonation.platform_banner_html", email: tag.strong(current_admin.email)).html_safe %></span>
        <%= button_to t("admin.impersonation.platform_exit"), platform_exit_path, method: :delete, class: "impersonation-banner-btn" %>
      </div>
    <% end %>
    <% topbar_socials = factory_social_links(current_factory) %>
    <% if current_factory.phone.present? || current_factory.business_hours.present? || topbar_socials.any? %>
      <div class="site-topbar">
        <div class="site-topbar-inner">
          <% if current_factory.phone.present? %>
            <a href="tel:<%= current_factory.phone.gsub(/\s+/, "") %>" class="site-topbar-phone">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span><%= current_factory.phone %></span>
            </a>
          <% end %>
          <% if current_factory.business_hours.present? %>
            <span class="site-topbar-hours">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span><%= t("topbar.hours_label") %> <%= current_factory.business_hours %></span>
            </span>
          <% end %>
          <% if topbar_socials.any? %>
            <div class="site-topbar-social">
              <% topbar_socials.each do |platform, url| %>
                <%= link_to url, class: "site-topbar-social-item",
                            target: "_blank", rel: "noopener noreferrer",
                            title: t("home.footer.social.#{platform}"),
                            aria: { label: t("home.footer.social.#{platform}") } do %>
                  <%= social_icon(platform) %>
                  <span><%= t("home.footer.social.#{platform}") %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <header class="site-header">
      <div class="header-container" data-controller="nav-toggle">
        <div class="site-brand-row">
          <%= link_to root_path, class: "site-brand", "aria-label": "#{current_factory.name} home" do %>
            <% if current_factory.logo.attached? %>
              <%= image_tag current_factory.logo, alt: current_factory.name, class: "site-brand-logo" %>
            <% else %>
              <span class="site-brand-text"><%= current_factory.name %></span>
            <% end %>
          <% end %>
          <% if admin_logged_in? %>
            <span class="plan-badge plan-badge-<%= current_factory.plan %>" title="<%= t("plan.#{current_factory.plan}") %>">
              <%= t("plan.#{current_factory.plan}") %>
            </span>
          <% end %>
        </div>
        <button type="button" class="nav-toggle"
                data-nav-toggle-target="button"
                data-action="click->nav-toggle#toggle"
                aria-expanded="false"
                aria-controls="primary-nav"
                aria-label="<%= t("admin.nav.menu") %>">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <nav class="site-nav" id="primary-nav" data-nav-toggle-target="menu" data-open="false">
          <ul>
            <% if admin_logged_in? %>
              <li><%= link_to t("admin.nav.requests"), admin_requests_path %></li>
              <% if current_admin&.admin? || current_admin&.coordinator? %>
                <li><%= link_to t("admin.nav.route"),   admin_route_path %></li>
                <li><%= link_to t("admin.nav.sms_log"), admin_sms_log_path %></li>
              <% end %>
              <% if current_admin&.admin? %>
                <li><%= link_to t("admin.nav.reports"),      admin_reports_path %></li>
                <li><%= link_to t("admin.nav.users"),        admin_users_path %></li>
                <li><%= link_to t("admin.nav.settings"),     admin_settings_path %></li>
                <li><%= link_to t("admin.nav.subscription"), admin_subscription_path %></li>
              <% end %>
              <li><%= link_to t("admin.nav.logout"), logout_path, data: { turbo_method: :delete }, class: "nav-logout" %></li>
            <% else %>
              <li><%= link_to t("nav.book"),        new_request_path %></li>
              <li><%= link_to t("nav.prices"),      root_path(anchor: "prices") %></li>
              <li><%= link_to t("nav.check_order"), status_path %></li>
              <li><%= link_to t("nav.faq"),         faq_path %></li>
              <li><%= link_to t("nav.contact"),     contacts_path %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <% if notice.present? %>
        <div class="flash-container <%= 'container-wide' if admin_logged_in? %>">
          <div class="flash flash-notice flash-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span><%= notice %></span>
          </div>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="flash-container <%= 'container-wide' if admin_logged_in? %>">
          <div class="flash flash-alert flash-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= alert %></span>
          </div>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <% unless admin_logged_in? %>
      <%= render "shared/cookie_consent" %>
    <% end %>
  </body>
</html>
