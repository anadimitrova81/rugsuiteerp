<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("marketing.meta.default_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "marketing/seo" %>

    <% if recaptcha_site_key.present? %>
      <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptcha_site_key %>" async defer></script>
    <% end %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= render "layouts/js_i18n" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="marketing-body">
    <header class="marketing-header">
      <div class="marketing-header-inner">
        <a href="/" class="marketing-brand">
          <span class="marketing-brand-mark" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v10H3z"/><path d="M3 12h18"/><path d="M7 7v10"/><path d="M17 7v10"/></svg>
          </span>
          <span class="marketing-brand-text">RugSuite<span class="marketing-brand-suffix">ERP</span></span>
        </a>
        <nav class="marketing-nav" aria-label="Primary">
          <a href="#features"><%= t("marketing.nav.features") %></a>
          <a href="#how-it-works"><%= t("marketing.nav.how_it_works") %></a>
          <a href="#pricing"><%= t("marketing.nav.pricing") %></a>
          <a href="#contact"><%= t("marketing.nav.contact") %></a>
        </nav>
        <div class="marketing-header-cta">
          <%= render "shared/locale_switcher" %>
          <%= link_to t("marketing.cta.trial"), marketing_signup_path, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer class="marketing-footer">
      <div class="marketing-footer-inner">
        <div class="marketing-footer-brand">
          <strong>RugSuite ERP</strong>
          <span><%= t("marketing.footer.tagline") %></span>
        </div>
        <div class="marketing-footer-links">
          <a href="#features"><%= t("marketing.nav.features") %></a>
          <a href="#pricing"><%= t("marketing.nav.pricing") %></a>
          <a href="#contact"><%= t("marketing.nav.contact") %></a>
        </div>
        <div class="marketing-footer-meta">
          <%= t("marketing.footer.copyright", year: Date.current.year) %>
        </div>
      </div>
    </footer>
  </body>
</html>
