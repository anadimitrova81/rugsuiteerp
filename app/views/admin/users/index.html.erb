<% content_for(:title) { "Потребители · Админ" } %>

<div class="container container-wide">
  <header class="page-header page-header-with-action">
    <div>
      <h1>Потребители</h1>
      <p class="page-subtitle"><%= pluralize(@users.size, "член на екипа", plural: "членове на екипа") %></p>
    </div>
    <%= link_to new_admin_user_path, class: "btn btn-primary" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      Нов потребител
    <% end %>
  </header>

  <% if @users.any? %>
    <div class="users-list">
      <% @users.each do |user| %>
        <div class="user-row">
          <div class="user-identity">
            <div class="user-avatar user-avatar-<%= user.role %>"><%= role_icon(user.role, size: 18) %></div>
            <div class="user-identity-text">
              <span class="user-email"><%= user.email %></span>
              <% if user == current_admin %>
                <span class="user-tag">Вие</span>
              <% end %>
              <span class="user-joined">Присъединил се на <%= bg_long_date(user.created_at) %></span>
            </div>
          </div>

          <div class="user-role-control">
            <%= form_with model: [:admin, user], url: admin_user_path(user), method: :patch do |form| %>
              <label class="user-role-pill user-role-pill-<%= user.role %>">
                <%= role_icon(user.role, size: 14) %>
                <%= form.select :role, User::ROLES.map { |r| [User::ROLE_LABELS[r], r] }, { skip_group: true }, { class: "user-role-select", onchange: "this.form.requestSubmit()" } %>
              </label>
            <% end %>
          </div>

          <div class="user-actions">
            <% unless user == current_admin %>
              <%= button_to impersonate_admin_user_path(user),
                            method: :post,
                            class: "user-impersonate",
                            title: "Влез като #{user.email}",
                            form: { data: { turbo_confirm: "Влез като #{user.email}?" } } do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m17 11 2 2 4-4"/></svg>
              <% end %>
              <%= link_to admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: "Сигурни ли сте, че искате да изтриете #{user.email}?" }, class: "user-delete", title: "Изтрий потребителя" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>Все още няма потребители.</p>
    </div>
  <% end %>
</div>
