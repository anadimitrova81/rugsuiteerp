<% content_for(:title) { "Маршрут за деня · Админ" } %>

<div class="container container-wide">
  <header class="request-detail-page-header">
    <div>
      <p class="request-detail-eyebrow">Маршрут</p>
      <h1 class="request-detail-title">Планиране за <%= bg_long_date(@date) %></h1>
      <p class="request-detail-subtitle">
        <%= @couriers.size %> <%= @couriers.size == 1 ? "куриер" : "куриера" %> ·
        Влачете спирки в желания ред или между лентите за пренасочване.
      </p>
    </div>
    <div class="request-detail-actions">
      <% if @stops_by_courier.values.flatten.any? %>
        <%= form_with url: optimize_admin_route_path, method: :post, class: "route-optimize-form" do |form| %>
          <fieldset class="route-optimize-couriers">
            <legend>Включи куриер</legend>
            <% @couriers.each do |courier| %>
              <label class="route-optimize-courier">
                <input type="checkbox" name="courier_ids[]" value="<%= courier.id %>" checked>
                <span><%= courier.email.split("@").first.capitalize %></span>
              </label>
            <% end %>
          </fieldset>
          <%= form.submit "Оптимизирай маршрута",
                          class: "btn btn-primary",
                          data: { turbo_confirm: "Това ще преразпредели спирките между избраните куриери. Продължи?" } %>
        <% end %>
      <% end %>
    </div>
  </header>

  <div class="route-lanes" data-controller="route-planner"
       data-route-planner-reorder-url-value="<%= reorder_admin_route_path %>">

    <% (@couriers + [nil]).each do |courier| %>
      <% lane_id = courier&.id %>
      <% lane_stops = @stops_by_courier[lane_id] || [] %>
      <% summary = courier ? @lane_summaries[courier.id] : nil %>
      <section class="route-lane <%= "route-lane-unassigned" if lane_id.nil? %>" data-lane-id="<%= lane_id %>">
        <header class="route-lane-header">
          <div>
            <h2><%= courier ? courier.email.split("@").first.capitalize : "Неназначени" %></h2>
            <p class="route-lane-meta">
              <%= lane_stops.size %> <%= lane_stops.size == 1 ? "спирка" : "спирки" %>
            </p>
          </div>
          <% if courier && lane_stops.any? %>
            <div class="route-lane-summary">
              <% if summary&.dig(:distance_km) %>
                <span class="route-lane-summary-value">
                  <%= number_with_precision(summary[:distance_km], precision: 1) %> км · <%= format_minutes_bg(summary[:total_minutes]) %>
                </span>
              <% else %>
                <%= button_to "Калкулирай", calculate_admin_route_path(lane: courier.id),
                              method: :post, class: "btn btn-secondary btn-sm" %>
              <% end %>
            </div>
          <% end %>
        </header>

        <% if lane_stops.any? %>
          <div class="route-planner-item route-planner-item-depot">
            <span class="route-planner-position">⌂</span>
            <span class="status-badge route-planner-status route-planner-depot-tag">Старт</span>
            <div class="route-planner-info">
              <span class="route-planner-id">Цех</span>
              <span class="route-planner-address"><%= Routes::DailyRouteOptimizer::DEPOT_ADDRESS %></span>
            </div>
          </div>
        <% end %>
        <ul class="route-planner route-lane-list" data-route-planner-target="list" data-lane-id="<%= lane_id %>">
          <% lane_stops.each do |stop| %>
            <li class="route-planner-item" data-stop-id="<%= stop.id %>">
              <span class="route-planner-handle" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="18" r="1"/></svg>
              </span>
              <span class="route-planner-position" data-route-planner-target="position">
                <%= stop.route_position || "—" %>
              </span>
              <span class="status-badge status-<%= stop.status %> route-planner-status">
                <%= Request::STATUS_LABELS[stop.status] %>
              </span>
              <div class="route-planner-info">
                <span class="route-planner-id">#<%= stop.customer_id %></span>
                <span class="route-planner-address"><%= stop.address %>, <%= stop.city %></span>
              </div>
              <span class="route-planner-time">
                <% target = stop.status == "delivery_confirmed" ? stop.delivery_at : stop.pick_up_at %>
                <%= target&.in_time_zone&.strftime("%H:%M") %>
              </span>
            </li>
          <% end %>
        </ul>
        <% if lane_stops.any? %>
          <div class="route-planner-item route-planner-item-depot">
            <span class="route-planner-position">⌂</span>
            <span class="status-badge route-planner-status route-planner-depot-tag">Край</span>
            <div class="route-planner-info">
              <span class="route-planner-id">Цех</span>
              <span class="route-planner-address"><%= Routes::DailyRouteOptimizer::DEPOT_ADDRESS %></span>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>

  <% if @stops_by_courier.values.flatten.empty? %>
    <div class="empty-state">
      <div class="empty-state-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 11 22 2 13 21 11 13 3 11"/></svg>
      </div>
      <p class="empty-state-title">Няма спирки за днес</p>
      <p class="empty-state-hint">Когато бъдат потвърдени поръчки за вземане или връщане, ще се появят тук.</p>
    </div>
  <% end %>
</div>
