<% content_for(:title) { t("admin.request.new.meta_title") } %>

<% if current_admin&.courier? %>
  <%= render "courier_new" %>
<% else %>
<div class="container container-wide">
  <header class="request-detail-page-header">
    <div>
      <p class="request-detail-eyebrow"><%= t("admin.request.new.eyebrow") %></p>
      <h1 class="request-detail-title"><%= t("admin.request.new.title") %></h1>
      <p class="request-detail-subtitle"><%= t("admin.request.new.lede") %></p>
    </div>
    <div class="request-detail-actions">
      <%= link_to admin_requests_path, class: "btn btn-secondary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <%= t("admin.request.show.back_to_list") %>
      <% end %>
    </div>
  </header>

  <% if @request.errors.any? %>
    <div class="flash flash-alert flash-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span><%= t("admin.request.new.errors") %></span>
    </div>
  <% end %>

  <%= form_with(model: @request, url: admin_requests_path, scope: :request, class: "request-form admin-request-form") do |form| %>
    <section class="form-section">
      <h2 class="form-section-title"><%= t("admin.request.edit.section_status") %></h2>
      <p class="form-section-hint"><%= t("admin.request.new.status_hint") %></p>
      <div class="status-picker">
        <% @statuses.each do |status| %>
          <label class="status-option">
            <%= form.radio_button :status, status, class: "status-option-input", checked: @request.status == status %>
            <span class="status-badge status-<%= status %> status-option-pill"><%= Request.status_labels[status] %></span>
          </label>
        <% end %>
      </div>
    </section>

    <section class="form-section">
      <h2 class="form-section-title"><%= t("admin.request.new.section_contact") %></h2>
      <%= form.telephone_field :phone, label: t("admin.request.labels.phone"), placeholder: t("admin.request.new.phone_placeholder") %>
    </section>

    <section class="form-section">
      <h2 class="form-section-title"><%= t("admin.request.labels.pickup_address") %></h2>
      <div class="form-row form-row-2-1">
        <%= form.text_field :address, label: t("admin.request.labels.address_line"), placeholder: t("admin.request.new.address_placeholder") %>
        <%= form.select :city, current_factory.service_cities, { label: t("admin.request.labels.city"), include_blank: t("admin.request.labels.select_city") } %>
      </div>
    </section>

    <section class="form-section">
      <h2 class="form-section-title"><%= t("admin.request.labels.schedule") %></h2>
      <%# No min: admins may set any pickup date, including the past (e.g. to
         backdate an already-completed order). The server skips the
         not-in-the-past rule for admin saves. %>
      <%= form.date_field :pick_up_at,
                          label: t("admin.request.labels.pickup_date"),
                          hint: t("admin.request.new.pickup_hint", pickup_window: current_factory.pickup_window),
                          onclick: "this.showPicker()" %>
      <%= form.text_area :pick_up_notes,
                         label: t("admin.request.labels.pickup_notes"),
                         rows: 3,
                         placeholder: t("admin.request.new.pickup_notes_placeholder") %>
      <%= form.date_field :delivery_at,
                          label: t("admin.request.labels.delivery_date"),
                          onclick: "this.showPicker()" %>
      <%= form.text_area :delivery_notes,
                         label: t("admin.request.labels.delivery_notes"),
                         rows: 3,
                         placeholder: t("admin.request.new.delivery_notes_placeholder") %>
    </section>

    <section class="form-section" data-controller="items-only">
      <h2 class="form-section-title"><%= t("admin.request.edit.section_processing") %></h2>
      <p class="form-section-hint"><%= t("admin.request.new.section_processing_hint") %></p>
      <label class="form-check">
        <%= form.check_box :items_only, data: { action: "items-only#toggle", items_only_target: "checkbox" } %>
        <span><%= t("admin.request.edit.items_only_label") %></span>
      </label>
      <label class="form-check">
        <%= form.check_box :pay_by_invoice %>
        <span><%= t("admin.request.edit.pay_by_invoice_label") %></span>
      </label>
      <label class="form-check">
        <%= form.check_box :bulk_price %>
        <span><%= t("admin.request.edit.bulk_price_label", rate: current_factory.price_per_kg_bulk, currency: "€") %></span>
      </label>
      <div class="form-row form-row-1-1">
        <%= form.number_field :number_of_items, label: t("admin.request.labels.items"), placeholder: "—", min: 0, step: 1 %>
        <div data-items-only-target="weightWrapper">
          <%= form.number_field :weight, label: t("admin.request.labels.weight_kg"), placeholder: "—", min: 0, step: 0.1 %>
        </div>
      </div>
    </section>

    <div class="form-actions form-actions-split">
      <%= link_to t("admin.common.cancel"), admin_requests_path, class: "btn btn-secondary" %>
      <%= form.submit t("admin.request.new.submit"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
<% end %>
