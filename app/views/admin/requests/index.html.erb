<% content_for(:title) { "Поръчки · Админ" } %>

<div class="container container-wide">
  <header class="page-header page-header-with-action">
    <h1>Поръчки</h1>
    <% if current_admin&.admin? %>
      <%= link_to "Нова поръчка", new_admin_request_path, class: "btn btn-primary" %>
    <% end %>
  </header>

  <% if @pending_price_notifications_count.to_i.positive? %>
    <div class="sms-banner">
      <span class="sms-banner-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </span>
      <div class="sms-banner-text">
        <span class="sms-banner-title">
          <%= @pending_price_notifications_count %> <%= @pending_price_notifications_count == 1 ? "поръчка" : "поръчки" %> чакат ценова оферта
        </span>
        <span class="sms-banner-meta">Изпратете SMS с тегло и сума на клиентите.</span>
      </div>
      <%= button_to "Изпрати SMS",
                    price_quotes_admin_notifications_path,
                    method: :post,
                    class: "btn btn-secondary sms-banner-btn",
                    data: { turbo_confirm: "Изпрати SMS оферти за #{@pending_price_notifications_count} поръчки?" } %>
    </div>
  <% end %>

  <% if current_admin&.courier? %>
    <%= render "courier_index" %>
  <% elsif current_admin&.operator? %>
    <%= render "operator_index" %>
  <% elsif current_admin&.coordinator? %>
    <%= render "coordinator_index" %>
  <% else %>

  <% if current_admin&.admin? %>
    <% filters_active = @query.present? || @from_date.present? || @to_date.present? %>
    <%= form_with url: admin_requests_path, method: :get, class: "requests-search-form" do |form| %>
      <div class="requests-search">
        <svg class="requests-search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <%= form.text_field :q, value: @query, placeholder: "Търсене по телефон или номер на поръчка", autocomplete: "off", class: "requests-search-input", skip_group: true %>
        <span class="requests-search-divider" aria-hidden="true"></span>
        <label class="requests-search-date">
          <span>От</span>
          <%= form.date_field :from, value: @from_date, skip_group: true %>
        </label>
        <label class="requests-search-date">
          <span>До</span>
          <%= form.date_field :to, value: @to_date, skip_group: true %>
        </label>
        <% if @current_status %>
          <%= hidden_field_tag :status, @current_status %>
        <% end %>
        <button type="submit" class="requests-search-submit">Приложи</button>
        <% if filters_active %>
          <%= link_to "Изчисти", admin_requests_path, class: "requests-search-clear" %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @query.present? && current_admin&.admin? %>
    <p class="requests-search-summary">
      <%= pluralize(@requests.size, "резултат", plural: "резултата") %> за <strong><%= @query %></strong>
    </p>
  <% end %>

  <% if @tab_statuses %>
    <% tab_date_params = { from: @from_date, to: @to_date }.compact_blank %>
    <nav class="status-tabs" aria-label="Филтриране по статус">
      <% @tab_statuses.each do |status| %>
        <%= link_to admin_requests_path({ status: status }.merge(tab_date_params)),
                    class: "status-tab #{'status-tab-active' if status == @current_status}" do %>
          <span class="status-tab-label"><%= Request::STATUS_LABELS[status] %></span>
          <span class="status-tab-count"><%= @status_counts[status].to_i %></span>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <% if @requests.any? %>
    <div class="requests-list">
      <div class="requests-list-header">
        <span>Поръчка</span>
        <span>Телефон</span>
        <span>Адрес</span>
        <span>Вземане</span>
        <span>Статус</span>
      </div>

      <% @requests.each do |req| %>
        <% next_status = next_status_for(req) %>
        <% if next_status %>
          <% extra_fields = transition_fields_for(req, next_status) %>
          <% extra_params = case extra_fields
                            when "items"  then { number_of_items: "" }
                            when "weight" then { weight: "" }
                            else {}
                            end %>
          <% url_params = { request: { status: next_status }.merge(extra_params) } %>
          <% confirm_message = case extra_fields
                               when "items"  then "Поръчка #{req.customer_id} — въведете брой артикули."
                               when "weight" then "Поръчка #{req.customer_id} — въведете общото тегло."
                               else "Маркиране на поръчка #{req.customer_id} като „#{Request::STATUS_LABELS[next_status]}”?"
                               end %>
          <%= button_to admin_request_path(req, **url_params),
                        method: :patch,
                        form_class: "requests-list-form",
                        class: "requests-list-row requests-list-row-advance",
                        data: { turbo_confirm: confirm_message, confirm_fields: extra_fields },
                        title: "Маркирай като #{Request::STATUS_LABELS[next_status]}" do %>
            <%= render "admin/requests/row_cells", req: req %>
          <% end %>
        <% else %>
          <%= link_to (current_admin&.admin? ? edit_admin_request_path(req) : admin_request_path(req)), class: "requests-list-row" do %>
            <%= render "admin/requests/row_cells", req: req %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
      </div>
      <p class="empty-state-title">Няма поръчки в този статус</p>
      <p class="empty-state-hint">Когато постъпят нови заявки, те ще се появят тук.</p>
    </div>
  <% end %>
  <% end %>
</div>
