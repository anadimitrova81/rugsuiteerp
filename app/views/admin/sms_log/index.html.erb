<% content_for(:title) { t("admin.sms_log.title") } %>

<div class="container container-wide">
  <header class="request-detail-page-header">
    <div>
      <p class="request-detail-eyebrow"><%= t("admin.sms_log.eyebrow") %></p>
      <h1 class="request-detail-title"><%= t("admin.sms_log.title") %></h1>
      <p class="request-detail-subtitle">
        <%= t("admin.sms_log.subtitle", count: @total_count) %>
      </p>
    </div>
    <div class="request-detail-actions">
      <%= link_to admin_requests_path, class: "btn btn-secondary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <%= t("admin.common.back_to_requests") %>
      <% end %>
    </div>
  </header>

  <%= form_with url: admin_sms_log_path, method: :get, class: "requests-search-form" do |form| %>
    <div class="requests-search">
      <svg class="requests-search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <%= form.text_field :q, value: @query, placeholder: t("admin.sms_log.search_placeholder"), autocomplete: "off", class: "requests-search-input", skip_group: true %>
      <span class="requests-search-divider" aria-hidden="true"></span>
      <label class="requests-search-date">
        <span><%= t("admin.sms_log.from") %></span>
        <%= form.date_field :from, value: @from_date, skip_group: true %>
      </label>
      <label class="requests-search-date">
        <span><%= t("admin.sms_log.to") %></span>
        <%= form.date_field :to, value: @to_date, skip_group: true %>
      </label>
      <% if @status_filter %>
        <%= hidden_field_tag :status, @status_filter %>
      <% end %>
      <button type="submit" class="requests-search-submit"><%= t("admin.sms_log.apply") %></button>
      <% if @query.present? || @from_date || @to_date %>
        <%= link_to t("admin.common.clear"), admin_sms_log_path(status: @status_filter), class: "requests-search-clear" %>
      <% end %>
    </div>
  <% end %>

  <% if @query.present? %>
    <p class="requests-search-summary">
      <%= t("admin.common.results_for_html", count: @notifications.size, q: h(@query)).html_safe %>
    </p>
  <% end %>

  <% sms_filter_params = { q: @query.presence, from: @from_date, to: @to_date }.compact_blank %>
  <nav class="status-tabs" aria-label="<%= t("admin.sms_log.title") %>">
    <%= link_to admin_sms_log_path(sms_filter_params),
                class: "status-tab #{'status-tab-active' if @status_filter.nil?}" do %>
      <span class="status-tab-label"><%= t("admin.sms_log.tab_all") %></span>
    <% end %>
    <%= link_to admin_sms_log_path(sms_filter_params.merge(status: "sent")),
                class: "status-tab #{'status-tab-active' if @status_filter == 'sent'}" do %>
      <span class="status-tab-label"><%= t("admin.sms_log.tab_sent") %></span>
    <% end %>
    <%= link_to admin_sms_log_path(sms_filter_params.merge(status: "failed")),
                class: "status-tab #{'status-tab-active' if @status_filter == 'failed'}" do %>
      <span class="status-tab-label"><%= t("admin.sms_log.tab_failed") %></span>
      <% if @failed_count.positive? %>
        <span class="status-tab-count sms-log-failed-count"><%= @failed_count %></span>
      <% end %>
    <% end %>
  </nav>

  <% if @notifications.any? %>
    <div class="courier-list" id="sms-log-list">
      <% @notifications.each do |notif| %>
        <%= render "admin/sms_log/sms_row", notif: notif %>
      <% end %>
    </div>
    <%= render "admin/sms_log/load_more" %>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <p class="empty-state-title"><%= t("admin.sms_log.empty_title") %></p>
      <p class="empty-state-hint"><%= t("admin.sms_log.empty_hint") %></p>
    </div>
  <% end %>
</div>
