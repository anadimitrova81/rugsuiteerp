<% content_for(:title) { t("marketing.home.page_title") } %>

<section class="mkt-hero">
  <div class="mkt-hero-inner">
    <div class="mkt-hero-text">
      <span class="mkt-eyebrow"><%= t("marketing.home.hero_eyebrow") %></span>
      <h1 class="mkt-hero-title"><%= t("marketing.home.hero_title") %></h1>
      <p class="mkt-hero-subtitle">
        <%= t("marketing.home.hero_subtitle") %>
      </p>
      <div class="mkt-hero-actions">
        <%= link_to t("marketing.home.start_free_trial"), marketing_signup_path, class: "btn btn-primary btn-lg" %>
        <a href="#how-it-works" class="btn btn-secondary btn-lg"><%= t("marketing.home.hero_see_how") %></a>
      </div>
      <ul class="mkt-hero-bullets">
        <li><%= t("marketing.home.hero_bullet_1") %></li>
        <li><%= t("marketing.home.hero_bullet_2") %></li>
        <li><%= t("marketing.home.hero_bullet_3") %></li>
      </ul>
    </div>
    <div class="mkt-hero-art" aria-hidden="true">
      <div class="mkt-hero-blob"></div>
      <div class="mkt-hero-grid"></div>
      <div class="mkt-hero-card mkt-hero-card-top">
        <div class="mkt-hero-card-row">
          <span class="mkt-pill mkt-pill-amber"><%= t("marketing.home.status_picked_up") %></span>
          <span class="mkt-hero-card-time">14:32</span>
        </div>
        <div class="mkt-hero-card-meta"><%= t("marketing.home.hero_card_pickup_meta") %></div>
      </div>
      <div class="mkt-hero-card mkt-hero-card-mid">
        <div class="mkt-hero-card-row">
          <span class="mkt-pill mkt-pill-blue"><%= t("marketing.home.status_in_wash") %></span>
          <span class="mkt-hero-card-time">15:08</span>
        </div>
        <div class="mkt-hero-card-meta"><%= t("marketing.home.hero_card_wash_meta") %></div>
      </div>
      <div class="mkt-hero-card mkt-hero-card-bottom">
        <div class="mkt-hero-card-row">
          <span class="mkt-pill mkt-pill-green"><%= t("marketing.home.status_ready") %></span>
          <span class="mkt-hero-card-time">17:15</span>
        </div>
        <div class="mkt-hero-card-meta"><%= t("marketing.home.hero_card_delivery_meta") %></div>
      </div>
    </div>
  </div>
</section>

