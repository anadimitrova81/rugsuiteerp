<section class="mkt-section mkt-section-alt" id="how-it-works">
  <div class="mkt-section-inner">
    <div class="mkt-section-head">
      <span class="mkt-eyebrow"><%= t("marketing.nav.how_it_works") %></span>
      <h2><%= t("marketing.home.how_title") %></h2>
    </div>
    <ol class="mkt-steps">
      <li class="mkt-step">
        <span class="mkt-step-num">01</span>
        <h3><%= t("marketing.home.step1_title") %></h3>
        <p><%= t("marketing.home.step1_body") %></p>
      </li>
      <li class="mkt-step">
        <span class="mkt-step-num">02</span>
        <h3><%= t("marketing.home.step2_title") %></h3>
        <p><%= t("marketing.home.step2_body") %></p>
      </li>
      <li class="mkt-step">
        <span class="mkt-step-num">03</span>
        <h3><%= t("marketing.home.step3_title") %></h3>
        <p><%= t("marketing.home.step3_body") %></p>
      </li>
      <li class="mkt-step">
        <span class="mkt-step-num">04</span>
        <h3><%= t("marketing.home.step4_title") %></h3>
        <p><%= t("marketing.home.step4_body") %></p>
      </li>
      <li class="mkt-step">
        <span class="mkt-step-num">05</span>
        <h3><%= t("marketing.home.step5_title") %></h3>
        <p><%= t("marketing.home.step5_body") %></p>
      </li>
      <li class="mkt-step">
        <span class="mkt-step-num">06</span>
        <h3><%= t("marketing.home.step6_title") %></h3>
        <p><%= t("marketing.home.step6_body") %></p>
      </li>
    </ol>
  </div>
</section>

<section class="mkt-section" id="pricing">
  <div class="mkt-section-inner">
    <div class="mkt-section-head">
      <span class="mkt-eyebrow"><%= t("marketing.nav.pricing") %></span>
      <h2><%= t("marketing.home.pricing_title") %></h2>
      <p class="mkt-section-lede"><%= t("marketing.home.pricing_lede") %></p>
    </div>
    <div class="mkt-pricing">
      <div class="mkt-tier">
        <h3 class="mkt-tier-name"><%= t("marketing.home.tier_free_name") %></h3>
        <p class="mkt-tier-tagline"><%= t("marketing.home.tier_free_tagline") %></p>
        <p class="mkt-tier-price"><span>€0</span></p>
        <ul class="mkt-tier-list">
          <li><%= t("marketing.home.tier_free_feat_1") %></li>
          <li><%= t("marketing.home.tier_free_feat_2") %></li>
          <li><%= t("marketing.home.tier_free_feat_3") %></li>
          <li><%= t("marketing.home.tier_free_feat_4") %></li>
        </ul>
      </div>
      <div class="mkt-tier mkt-tier-featured">
        <span class="mkt-tier-badge"><%= t("marketing.home.tier_badge_popular") %></span>
        <h3 class="mkt-tier-name"><%= t("marketing.home.tier_starter_name") %></h3>
        <p class="mkt-tier-tagline"><%= t("marketing.home.tier_starter_tagline") %></p>
        <p class="mkt-tier-price"><span>€49</span><small><%= t("marketing.home.per_month") %></small></p>
        <ul class="mkt-tier-list">
          <li><%= t("marketing.home.tier_starter_feat_1") %></li>
          <li><%= t("marketing.home.tier_starter_feat_2") %></li>
          <li><%= t("marketing.home.tier_starter_feat_3") %></li>
          <li><%= t("marketing.home.tier_starter_feat_4") %></li>
        </ul>
      </div>
      <div class="mkt-tier">
        <h3 class="mkt-tier-name"><%= t("marketing.home.tier_pro_name") %></h3>
        <p class="mkt-tier-tagline"><%= t("marketing.home.tier_pro_tagline") %></p>
        <p class="mkt-tier-price"><span>€99</span><small><%= t("marketing.home.per_month") %></small></p>
        <ul class="mkt-tier-list">
          <li><%= t("marketing.home.tier_pro_feat_1") %></li>
          <li><%= t("marketing.home.tier_pro_feat_2") %></li>
          <li><%= t("marketing.home.tier_pro_feat_3") %></li>
          <li><%= t("marketing.home.tier_pro_feat_4") %></li>
        </ul>
        <a href="#contact" class="mkt-tier-note"><%= t("marketing.home.tier_pro_contact") %></a>
      </div>
    </div>
  </div>
</section>

<section class="mkt-section mkt-section-cta" id="signup">
  <div class="mkt-section-inner mkt-cta">
    <h2><%= t("marketing.home.cta_title") %></h2>
    <p><%= t("marketing.home.cta_subtitle") %></p>
    <div class="mkt-cta-actions">
      <%= link_to t("marketing.home.start_free_trial"), marketing_signup_path, class: "btn btn-primary btn-lg" %>
      <a href="#contact" class="btn btn-secondary btn-lg"><%= t("marketing.home.talk_to_us_first") %></a>
    </div>
  </div>
</section>

<section class="mkt-section" id="contact">
  <div class="mkt-section-inner mkt-contact">
    <div>
      <span class="mkt-eyebrow"><%= t("marketing.nav.contact") %></span>
      <h2><%= t("marketing.home.contact_title") %></h2>
      <p><%= t("marketing.home.contact_body") %></p>
    </div>
    <ul class="mkt-contact-list">
      <li><strong><%= t("marketing.home.contact_email_label") %></strong><a href="mailto:hello@rugsuite.app">hello@rugsuite.app</a></li>
      <li><strong><%= t("marketing.home.contact_sales_label") %></strong><a href="mailto:sales@rugsuite.app">sales@rugsuite.app</a></li>
      <li><strong><%= t("marketing.home.contact_support_label") %></strong><a href="mailto:support@rugsuite.app">support@rugsuite.app</a></li>
    </ul>
  </div>
</section>
