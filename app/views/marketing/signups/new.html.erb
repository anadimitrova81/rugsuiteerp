<% content_for(:title) { t("marketing.signup.page_title") } %>

<section class="mkt-signup">
  <div class="mkt-signup-inner">
    <div class="mkt-signup-intro">
      <span class="mkt-eyebrow"><%= t("marketing.signup.eyebrow") %></span>
      <h1><%= t("marketing.signup.title") %></h1>
      <p><%= t("marketing.signup.intro_html") %></p>

      <ul class="mkt-signup-bullets">
        <li><%= t("marketing.signup.bullet_1") %></li>
        <li><%= t("marketing.signup.bullet_2") %></li>
        <li><%= t("marketing.signup.bullet_3") %></li>
      </ul>
    </div>

    <div class="mkt-signup-card">
      <%# data: { turbo: false } — submit as a regular HTML POST so the
          cross-origin redirect to <slug>.localhost works on success. Turbo
          intercepts otherwise and can't navigate across origins cleanly.
          When a reCAPTCHA site key is set, the recaptcha controller fetches a
          v3 token into the hidden field just before submit. %>
      <% form_data = { turbo: false } %>
      <% if recaptcha_site_key.present? %>
        <% form_data.merge!(controller: "recaptcha", recaptcha_site_key_value: recaptcha_site_key, recaptcha_action_value: "signup") %>
      <% end %>
      <%= form_with(model: @form, url: marketing_signup_path, method: :post, scope: :signup, data: form_data, class: "mkt-form") do |f| %>
        <% if @form.errors.any? %>
          <div class="mkt-form-error mkt-form-error-base">
            <strong><%= t("marketing.signup.error_heading") %></strong>
            <ul>
              <% @form.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mkt-form-row">
          <%= f.label :name, t("marketing.signup.company_name_label"), class: "mkt-form-label" %>
          <%= f.text_field :name, skip_group: true, class: "mkt-form-input", placeholder: t("marketing.signup.company_name_placeholder"), autofocus: true, autocomplete: "organization" %>
          <% if @form.errors[:name].any? %><p class="mkt-form-error"><%= @form.errors[:name].first %></p><% end %>
        </div>

        <div class="mkt-form-row">
          <%= f.label :slug, t("marketing.signup.subdomain_label"), class: "mkt-form-label" %>
          <div class="mkt-form-slug">
            <%= f.text_field :slug, skip_group: true, class: "mkt-form-input mkt-form-slug-input", placeholder: t("marketing.signup.subdomain_placeholder"), autocomplete: "off" %>
            <span class="mkt-form-slug-suffix">.rugsuite.app</span>
          </div>
          <p class="mkt-form-hint"><%= t("marketing.signup.subdomain_hint") %></p>
          <% if @form.errors[:slug].any? %><p class="mkt-form-error"><%= @form.errors[:slug].first %></p><% end %>
        </div>

        <div class="mkt-form-row">
          <%= f.label :country_code, t("marketing.signup.country_label"), class: "mkt-form-label" %>
          <%= f.select :country_code, CountryDefaults.select_options, { include_blank: t("marketing.signup.country_blank"), skip_group: true }, class: "mkt-form-input" %>
          <p class="mkt-form-hint"><%= t("marketing.signup.country_hint") %></p>
          <% if @form.errors[:country_code].any? %><p class="mkt-form-error"><%= @form.errors[:country_code].first %></p><% end %>
        </div>

        <hr class="mkt-form-divider">

        <div class="mkt-form-row">
          <%= f.label :admin_email, t("marketing.signup.admin_email_label"), class: "mkt-form-label" %>
          <%= f.email_field :admin_email, skip_group: true, class: "mkt-form-input", placeholder: t("marketing.signup.admin_email_placeholder"), autocomplete: "email" %>
          <% if @form.errors[:admin_email].any? %><p class="mkt-form-error"><%= @form.errors[:admin_email].first %></p><% end %>
        </div>

        <div class="mkt-form-row">
          <%= f.label :admin_password, t("marketing.signup.password_label"), class: "mkt-form-label" %>
          <%= f.password_field :admin_password, skip_group: true, class: "mkt-form-input", autocomplete: "new-password" %>
          <p class="mkt-form-hint"><%= t("marketing.signup.password_hint") %></p>
          <% if @form.errors[:admin_password].any? %><p class="mkt-form-error"><%= @form.errors[:admin_password].first %></p><% end %>
        </div>

        <% if recaptcha_site_key.present? %>
          <input type="hidden" name="g-recaptcha-response" data-recaptcha-target="token">
        <% end %>

        <%= f.submit t("marketing.signup.submit"), class: "btn btn-primary btn-full btn-lg" %>

        <% if recaptcha_site_key.present? %>
          <p class="recaptcha-notice"><%= t("requests.form.recaptcha_notice_html") %></p>
        <% end %>

        <p class="mkt-form-fine">
          <%= t("marketing.signup.fine_print") %>
        </p>
      <% end %>
    </div>
  </div>
</section>
